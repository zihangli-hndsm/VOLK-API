{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "volk.build.hosted-deployment.v1"
    },
    "workspaceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "workspaceRevision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "agentId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "tool": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "const": "count-distinct-category-codes"
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "properties": {
              "categoryCode": {
                "type": "string",
                "pattern": "^[A-Z0-9_-]{1,24}$"
              }
            },
            "required": [
              "categoryCode"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "rows"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "workspaceId",
    "workspaceRevision",
    "agentId",
    "tool"
  ],
  "additionalProperties": false
}
