{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private Hosted Build v2 deployment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "executionProfile",
    "agent",
    "tool",
    "recipe",
    "dataset"
  ],
  "properties": {
    "schemaVersion": {
      "const": "volk.build.hosted-deployment.v2"
    },
    "executionProfile": {
      "const": "data-prepare-category-dedup-fixture-v1"
    },
    "agent": {
      "$ref": "#/$defs/sourceBlob"
    },
    "tool": {
      "$ref": "#/$defs/sourceBlob"
    },
    "recipe": {
      "$ref": "#/$defs/sourceBlob"
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "fixtureId"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/resourceRef"
        },
        "fixtureId": {
          "const": "synthetic-category-codes-json-v1"
        }
      }
    }
  },
  "$defs": {
    "resourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspaceId",
        "resourceId",
        "revision",
        "contentSha256"
      ],
      "properties": {
        "workspaceId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "resourceId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "contentSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "sourceBlob": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "bodyBase64"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/resourceRef"
        },
        "bodyBase64": {
          "type": "string",
          "minLength": 4,
          "maxLength": 5464,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      }
    }
  }
}
