{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zihangli-hndsm/VOLK-API/main/formats/schemas/cloud-learning-context.schema.json",
  "title": "Optional v0 LUMI learning-context extension",
  "description": "Additive optional request field for a package-driven episode. Existing /v0/lumi/respond requests remain valid without this field.",
  "type": "object",
  "additionalProperties": false,
  "required": ["package", "currentNode", "allowedCandidates"],
  "properties": {
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "contentVersion", "fingerprint"],
      "properties": {
        "id": { "$ref": "manifest.schema.json#/$defs/id" },
        "contentVersion": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$", "maxLength": 64 },
        "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "currentNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "$ref": "learning.schema.json#/$defs/id" },
        "kind": { "enum": ["orientation", "prediction", "action", "observation", "reflection", "choice", "end"] }
      }
    },
    "allowedCandidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/candidate" }
    }
  },
  "$defs": {
    "candidate": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["candidateId", "action", "payload", "requiresLearnerConfirmation"], "properties": { "candidateId": { "$ref": "learning.schema.json#/$defs/id" }, "action": { "const": "ASK" }, "payload": { "type": "object", "additionalProperties": false, "required": ["question"], "properties": { "question": { "type": "string", "minLength": 1, "maxLength": 2000 } } }, "requiresLearnerConfirmation": { "const": false } } },
        { "type": "object", "additionalProperties": false, "required": ["candidateId", "action", "payload", "requiresLearnerConfirmation"], "properties": { "candidateId": { "$ref": "learning.schema.json#/$defs/id" }, "action": { "const": "SUGGEST_EXPERIMENT" }, "payload": { "type": "object", "additionalProperties": false, "required": ["recipeId", "description"], "properties": { "recipeId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 128 }, "description": { "type": "string", "minLength": 1, "maxLength": 2000 } } }, "requiresLearnerConfirmation": { "const": true } } },
        { "type": "object", "additionalProperties": false, "required": ["candidateId", "action", "payload", "requiresLearnerConfirmation"], "properties": { "candidateId": { "$ref": "learning.schema.json#/$defs/id" }, "action": { "enum": ["PROPOSE_HYPOTHESIS", "PROPOSE_COUNTEREXAMPLE"] }, "payload": { "type": "object", "additionalProperties": false, "required": ["text"], "properties": { "text": { "type": "string", "minLength": 1, "maxLength": 2000 } } }, "requiresLearnerConfirmation": { "const": true } } },
        { "type": "object", "additionalProperties": false, "required": ["candidateId", "action", "payload", "requiresLearnerConfirmation"], "properties": { "candidateId": { "$ref": "learning.schema.json#/$defs/id" }, "action": { "enum": ["NAME_CONNECTION", "REFLECT_PATH"] }, "payload": { "type": "object", "additionalProperties": false, "required": ["text"], "properties": { "text": { "type": "string", "minLength": 1, "maxLength": 2000 } } }, "requiresLearnerConfirmation": { "const": false } } },
        { "type": "object", "additionalProperties": false, "required": ["candidateId", "action", "payload", "requiresLearnerConfirmation"], "properties": { "candidateId": { "$ref": "learning.schema.json#/$defs/id" }, "action": { "const": "HIGHLIGHT_EVIDENCE" }, "payload": { "type": "object", "additionalProperties": false, "required": ["evidenceIds"], "properties": { "evidenceIds": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } }, "facts": { "type": "array", "maxItems": 16, "items": { "type": "string", "maxLength": 256 } } } }, "requiresLearnerConfirmation": { "const": false } } },
        { "type": "object", "additionalProperties": false, "required": ["candidateId", "action", "payload", "requiresLearnerConfirmation"], "properties": { "candidateId": { "$ref": "learning.schema.json#/$defs/id" }, "action": { "const": "OFFER_COMPARISON" }, "payload": { "type": "object", "maxProperties": 0 }, "requiresLearnerConfirmation": { "const": false } } },
        { "type": "object", "additionalProperties": false, "required": ["candidateId", "action", "payload", "requiresLearnerConfirmation"], "properties": { "candidateId": { "$ref": "learning.schema.json#/$defs/id" }, "action": { "const": "OFFER_DEPTH" }, "payload": { "type": "object", "additionalProperties": false, "required": ["target"], "properties": { "target": { "enum": ["evidence", "mechanism", "representation", "math", "builder"] } } }, "requiresLearnerConfirmation": { "const": false } } }
      ]
    }
  }
}
